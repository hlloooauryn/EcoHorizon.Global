              "raw": "{\n    \"service_level_id\": 1,\n    \"destination_type\": \"door_address\",\n    \"origin_location_id\": 1,\n    \"destination_location_id\": 4,\n    \"sender_business_name\": \"PT Nusantara Solusi Ekspor\",\n    \"sender_contact_name\": \"Budi Santoso\",\n    \"sender_phone\": \"+62 812 9988 7766\",\n    \"sender_address\": \"Kawasan Berikat Nusantara, Tanjung Priok, Jakarta\",\n    \"receiver_business_name\": \"Rotterdam Clean Energy BV\",\n    \"receiver_contact_name\": \"Jan van Dijk\",\n    \"receiver_phone\": \"+31 10 9988 776\",\n    \"receiver_address\": \"Maasvlakte II Logistics Avenue 12, Rotterdam, Netherlands\",\n    \"cargo_description\": \"Smart Energy Battery Inverters\",\n    \"cargo_weight_tonnes\": 18.5,\n    \"package_count\": 24,\n    \"package_type\": \"Industrial Euro Pallets\",\n    \"initial_leg_mode\": \"sea\",\n    \"initial_carrier_name\": \"Maersk Triple-E Vessel\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/shipments",
              "host": ["{{baseUrl}}"],
