                }
              ]
            },
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/shipments?status=IN_TRANSIT",
              "host": ["{{baseUrl}}"],
              "path": ["shipments"],
              "query": [
                {
                  "key": "status",
                  "value": "IN_TRANSIT"
                }
              ]
            }
          }
        },
