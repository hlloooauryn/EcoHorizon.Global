              "raw": "{\n    \"event_type\": \"WAYPOINT_CHECKPOINT\",\n    \"new_status\": \"IN_TRANSIT\",\n    \"location_name\": \"Suez Canal Northbound Checkpoint\",\n    \"description\": \"Vessel convoy exited Great Bitter Lake. Speed 8.5 knots.\"\n}"
